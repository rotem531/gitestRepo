jira.Automation Remove_a_label_from_all_work_items@s {
  name = "Remove a label from all work items"
  state = "ENABLED"
  description = "Quickly clean up deprecated labels. When this rule is triggered, it will automatically remove a specific label from all tickets in the space."
  canOtherRuleTrigger = false
  notifyOnError = "FIRSTERROR"
  authorAccountId = {
    id = "712020:38da96f3-a719-4d9f-8bb5-d53ff08774e0"
    displayName = "Rotem Cohen"
  }
  actor = {
    type = "ACCOUNT_ID"
    actor = "557058:f58131cb-b67d-43c7-b30d-6b58d40bd077"
  }
  trigger = {
    component = "TRIGGER"
    schemaVersion = 3
    type = "jira.manual.trigger.issue"
    value = {
      inputFromUsers = false
      inputPrompts = [
      ]
      groups = [
      ]
    }
    conditions = [
    ]
    id = "bac1e3de-c5ae-44f2-849c-7f88e0c70ce3"
  }
  components = [
    {
      component = "ACTION"
      schemaVersion = -1
      type = "jira.create.variable"
      value = {
        id = "label-to-remove-id"
        name = {
          type = "FREE"
          value = "labelToRemove"
        }
        type = "SMART"
        query = {
          type = "SMART"
          value = "my-label-to-remove"
        }
        lazy = false
      }
      conditions = [
      ]
      children = [
      ]
      id = "05666f5a-e943-4e56-99e4-5c6e10398846"
    },
    {
      component = "BRANCH"
      schemaVersion = 1
      type = "jira.issue.related"
      value = {
        relatedType = "jql"
        jql = "${ jira.Field.instance.Labels__array }={{labelToRemove}}"
        linkTypes = [
        ]
        onlyUpdatedIssues = true
        similarityLimit = 0
        compareValue = 0
      }
      conditions = [
      ]
      children = [
        {
          component = "ACTION"
          schemaVersion = 12
          type = "jira.issue.edit"
          value = {
            operations = [
              {
                field = {
                  type = "ID"
                  value = jira.Field.instance.Labels__array
                }
                fieldType = "labels"
                type = "ADDREMOVE"
                value = {
                  REMOVE = [
                    {
                      type = "SMART"
                      value = "{{labelToRemove}}"
                    },
                  ]
                  ADD = [
                    {
                      type = "NAME"
                      value = "content"
                    },
                  ]
                }
              },
            ]
            sendNotifications = false
          }
          conditions = [
          ]
          parentId = "a8466a83-649f-444b-930e-1d811a10e54a"
          children = [
          ]
          id = "9aaec8ff-2afa-4375-a0bf-ce3960ac14c6"
        },
      ]
      id = "a8466a83-649f-444b-930e-1d811a10e54a"
    },
    {
      component = "ACTION"
      schemaVersion = 12
      type = "jira.issue.edit"
      value = {
        operations = [
          {
            field = {
              type = "ID"
              value = jira.Field.instance.Labels__array
            }
            fieldType = "labels"
            type = "ADDREMOVE"
            value = {
              REMOVE = [
                {
                  type = "SMART"
                  value = "{{labelToRemove}}"
                },
              ]
              ADD = [
                {
                  type = "NAME"
                  value = "content"
                },
              ]
            }
          },
        ]
        sendNotifications = false
      }
      conditions = [
      ]
      children = [
      ]
      id = "27e3fcaf-0255-4ee6-81a8-c0a6d9466c3d"
    },
  ]
  ruleScopeARIs = [
    "ari:cloud:jira:71e61b65-4676-404d-96f0-38fbadce3261:project/10039",
  ]
  labels = [
    jira.AutomationLabel.instance.testLabel,
    jira.AutomationLabel.instance.ASD,
  ]
  writeAccessType = "UNRESTRICTED"
  collaborators = [
  ]
  uuid = "019dd402-84aa-73c3-9455-3b558fb3af3d"
  _alias = "Remove a label from all work items"
}
